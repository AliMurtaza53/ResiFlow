# Copy to .env and adjust paths (optional; export manually or use direnv).
# ResiFlow prefers RESIFLOW_*; NIRD_* names are supported as fallbacks.

# --- Required for numbered scripts ---
RESIFLOW_CONFIG_PATH=config.json
# RESIFLOW_RESULTS_VARIANT=revision

# --- Data overrides (optional) ---
# RESIFLOW_FAF5_OD_MATRIX_PATH=C:/NIRD_Data/faf5_data/processed/faf5_county_truck_od_usa_2022_total.parquet
# RESIFLOW_PASSENGER_OD_PATH=C:/NIRD_Data/lodes_data/processed/lodes_passenger_assignment_od_jt00_2022.parquet
# RESIFLOW_LODES_DATA_ROOT=C:/NIRD_Data/lodes_data

# --- Script 1 assignment tuning ---
# RESIFLOW_MAX_FLOW_ITERATIONS=2
# RESIFLOW_SAMPLE_OD_N=50000
# RESIFLOW_DISABLE_PASSENGER_OD=0

# --- Script 4 rerouting ---
# RESIFLOW_ENABLE_PASSENGER_REROUTING=1

# --- Hazard mode (default flood) ---
# RESIFLOW_HAZARD_TYPE=flood

# --- Network source heuristic ---
# RESIFLOW_NETWORK_SOURCE=faf5
