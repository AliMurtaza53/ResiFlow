.pytest-tmp/
.pytest_cache/
__pycache__/
*.egg-info/
.venv/
venv/
dist/
build/

# Local configuration and secrets
config.json
.env
.env.local

# Large local hazard downloads (see inputs/multihazard_raw/README.md)
inputs/multihazard_raw/
inputs/multihazard_aligned/

# Run outputs
# NOTE: results/ (not results) so the finale_2026_08 exception below can
# actually take effect -- git will not descend into a directory excluded via
# a trailing-slash pattern to apply file-level re-includes, even with `!`.
results/*
# Exception: track the finale figure-generation scripts themselves (not their
# PNG/CSV outputs) -- these are paper-reproducibility code, not run output.
!results/finale_2026_08/
results/finale_2026_08/*
!results/finale_2026_08/*.py
logs/
experiments/perf_numcpu/runs/
experiments/pass_a_convergence/runs/

# Morris SA generated artifacts (keep the tracked dispatch example)
sa_runs/*
!sa_runs/dispatch_example.sh
*.duckdb
*.duckdb.wal

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
