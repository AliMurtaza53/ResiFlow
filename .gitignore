.pytest-tmp/
.pytest_cache/
__pycache__/
*.egg-info/
.venv/
venv/
dist/
build/

# Local configuration and secrets
config.json
.env
.env.local

# Large local hazard downloads (see inputs/multihazard_raw/README.md)
inputs/multihazard_raw/
inputs/multihazard_aligned/

# Copyrighted published papers -- kept locally for reference (see
# docs/reference/README.md) but not redistributable via a public repo,
# unlike the government-published documents also under docs/reference/.
docs/reference/pant_hazardpaper_trd_new.pdf
docs/reference/SupplementaryInfo_pant_trdpaper.pdf

# Run outputs
# NOTE: results/ (not results) so the finale_2026_08 exception below can
# actually take effect -- git will not descend into a directory excluded via
# a trailing-slash pattern to apply file-level re-includes, even with `!`.
results/*
# Exception: track the finale figure-generation scripts themselves (not their
# PNG/CSV outputs) -- these are paper-reproducibility code, not run output.
!results/finale_2026_08/
results/finale_2026_08/*
!results/finale_2026_08/*.py
logs/
experiments/perf_numcpu/runs/
experiments/pass_a_convergence/runs/

# Morris SA generated artifacts (keep the tracked dispatch example)
sa_runs/*
!sa_runs/dispatch_example.sh
*.duckdb
*.duckdb.wal

# Raw/bulky source downloads for parameter-table sourcing work -- kept
# locally for reference (e.g. EMFAC exports, scratch working copies) but not
# meant to live alongside the curated T## tables in parameters/tables/.
parameters/tables/raw/

# Generated hazard-footprint comparison figures -- regenerate from
# scripts/figures/plot_hazard_footprints_*.py rather than tracking output,
# same convention as results/.
scripts/figures/*.png
scripts/figures/*.pdf

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
